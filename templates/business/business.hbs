<section class="nci-terminal nci-business{{#if readOnly}} nci-readonly{{/if}}">
  <nav class="nci-tabs">
    {{#if business}}
    {{#unless business.invited}}
    {{#each tabs}}<button type="button" data-action="switchTab" data-tab="{{id}}" class="{{#if active}}active{{/if}}">{{label}}</button>{{/each}}
    {{/unless}}
    <button type="button" data-action="startNew" title="{{localize 'NCI.Business.StartHint'}}"><i class="fas fa-plus"></i> {{localize "NCI.Business.Start"}}</button>
    {{/if}}
    <div class="nci-pickers">
      {{#if picker.businesses.length}}
      <select name="businessId" title="{{localize 'NCI.Business.Which'}}">
        {{#each picker.businesses}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      {{/if}}
      {{#if picker.actors.length}}
      <select name="actorId" class="nci-actor" title="{{localize 'NCI.Business.Character'}}">
        {{#each picker.actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
      </select>
      {{/if}}
    </div>
  </nav>

  {{#unless picker.enabled}}<p class="nci-warn">{{localize "NCI.Business.Disabled"}}</p>{{/unless}}
  {{#if readOnly}}<p class="nci-warn">{{localize "NCI.Business.ReadOnly"}}</p>{{/if}}
  {{#if picker.noGM}}<p class="nci-warn">{{localize "NCI.Portfolio.NoGM"}}</p>{{/if}}
  {{#if picker.pending}}<p class="nci-warn">{{localize "NCI.Portfolio.PendingRequests"}}: {{picker.pending}}</p>{{/if}}

  {{#if noActor}}<p class="nci-empty">{{localize "NCI.Business.NoCharacter"}}</p>{{/if}}

  {{#if jobs.length}}
  <div class="nci-block">
    <h3>{{localize "NCI.Staff.Jobs"}}</h3>
    <table class="nci-market"><tbody>
      {{#each jobs}}
      <tr>
        <td><strong>{{name}}</strong> <span class="nci-muted">{{archetype}}</span>
          <div class="nci-muted">{{post}} &middot; {{localize "NCI.Staff.WageWeek" wage=wage}}{{#if since}} &middot; {{localize "NCI.Staff.Since" date=since}}{{/if}}</div>
          {{#if owed}}<div class="nci-warn">{{owed}}</div>{{/if}}
          {{#if overtime}}<div class="nci-muted">{{overtime}}</div>{{/if}}
          {{#each asks}}<div class="nci-warn">{{text}}
            <button type="button" class="nci-labelled" data-action="rollAsked" data-business="{{../businessId}}" data-id="{{id}}"><i class="fas fa-dice-d10"></i> {{localize "NCI.Staff.RollAsked"}}</button>
            <button type="button" class="nci-labelled" data-action="declineAsk" data-business="{{../businessId}}" data-id="{{id}}"><i class="fas fa-xmark"></i> {{localize "NCI.Staff.DeclineAsk"}}</button></div>{{/each}}</td>
        <td class="nci-rowbtns">
          {{#if offered}}
          <button type="button" class="nci-labelled" data-action="acceptJob" data-id="{{businessId}}"><i class="fas fa-handshake"></i> {{localize "NCI.Staff.Accept"}}</button>
          <button type="button" class="nci-labelled" data-action="declineJob" data-id="{{businessId}}"><i class="fas fa-xmark"></i> {{localize "NCI.Staff.Decline"}}</button>
          {{else}}
          <button type="button" class="nci-labelled" data-action="quitJob" data-id="{{businessId}}"><i class="fas fa-person-walking-arrow-right"></i> {{localize "NCI.Staff.Quit"}}</button>
          {{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody></table>
    <p class="nci-hint">{{localize "NCI.Staff.JobsHint"}}</p>
  </div>
  {{/if}}

  {{#if start}}
  <div class="nci-block nci-form">
    <h3>{{localize "NCI.Business.Start"}}</h3>
    <p class="nci-hint">{{localize "NCI.Business.StartIntro"}}</p>
    <div class="nci-grid">
      <label>{{localize "NCI.Business.Name"}}<input type="text" name="name" maxlength="60"></label>
      <label>{{localize "NCI.Business.Kind"}}
        <select name="archetype">{{#each start.archetypes}}<option value="{{value}}" title="{{hint}}">{{label}}</option>{{/each}}</select>
      </label>
      <label>{{localize "NCI.Business.District"}}
        <select name="district">{{#each start.districts}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
      </label>
      <label>{{localize "NCI.Business.Location"}}<input type="text" name="location" maxlength="80" placeholder="{{localize 'NCI.Business.LocationHint'}}"></label>
      <label>{{localize "NCI.Business.Cash"}} <span class="nci-muted">({{localize "NCI.Business.YouHave" amount=start.wealth}})</span><input type="number" name="cash" min="0" step="50" value="0"></label>
    </div>
    {{#if @root.isSyndicate}}<p class="nci-hint">{{localize "NCI.Business.SyndicateCashOnly"}}</p>{{else}}
    <div class="nci-drop" data-gear="start">
      <p class="nci-hint"><i class="fas fa-hand-pointer"></i> {{localize "NCI.Business.GearDrop"}}</p>
      {{#each gearDrafts.start}}
      <div class="nci-gearrow">{{#if img}}<img src="{{img}}" alt="">{{/if}}<span>{{name}}</span><strong>{{value}} eb</strong>{{#if fromActor}}<span class="nci-muted">{{localize "NCI.Business.GearLeaves"}}</span>{{/if}}
        <button type="button" data-action="removeGear" data-form="start" data-index="{{@index}}" title="{{localize 'NCI.Business.GearRemove'}}"><i class="fas fa-xmark"></i></button></div>
      {{/each}}
    </div>
    {{/if}}
    <ul class="nci-hint">{{#each start.archetypes}}<li><strong>{{label}}</strong>: {{hint}}</li>{{/each}}</ul>
    {{#if start.partners.length}}
    <fieldset>
      <legend>{{localize "NCI.Business.Invite"}}</legend>
      {{#each start.partners}}<span class="nci-pick"><input type="checkbox" name="invite" value="{{id}}" aria-label="{{name}}"> {{{who}}}</span>{{/each}}
    </fieldset>
    {{/if}}
    <div class="nci-grid">
      <label>{{localize "NCI.Business.SweatPct" max=start.maxSweat}}<input type="number" name="sweatPct" min="0" max="{{start.maxSweat}}" step="1" value="0"></label>
      <label>{{localize "NCI.Business.SweatTo"}}
        <select name="sweatTo"><option value="">{{localize "NCI.Business.Me"}}</option>{{#each start.partners}}<option value="{{id}}">{{name}}</option>{{/each}}</select>
      </label>
    </div>
    <p class="nci-hint">{{localize "NCI.Business.SweatHint"}}</p>
    <footer class="nci-footer">
      <button type="button" data-action="cancelStart"><i class="fas fa-xmark"></i> {{localize "NCI.Business.CancelStart"}}</button>
      <button type="button" data-action="found"><i class="fas fa-store"></i> {{localize "NCI.Business.Found"}}</button>
    </footer>
  </div>
  {{/if}}

  {{#with business}}
  <header class="nci-header">
    <div><strong>{{name}}</strong> <span class="nci-muted">{{archetype}}{{#if location}} &middot; {{location}}{{/if}}</span></div>
    <div>{{stage}}{{#if ticker}} ({{ticker}}){{/if}} &middot; <strong>{{statusLabel}}</strong></div>
  </header>

  {{#if invited}}
  <div class="nci-block nci-form">
    <h3>{{localize "NCI.Business.Invitation"}}</h3>
    {{#if offer}}
    <p>{{offer}}</p>
    <footer class="nci-footer">
      <button type="button" data-action="join"><i class="fas fa-handshake"></i> {{localize "NCI.Business.Accept"}}</button>
      <button type="button" data-action="decline"><i class="fas fa-xmark"></i> {{localize "NCI.Business.Decline"}}</button>
    </footer>
  </div>
  {{else}}
    <p class="nci-hint">{{localize "NCI.Business.InvitationIntro" name=name}}</p>
    <div class="nci-grid">
      <label>{{localize "NCI.Business.Cash"}}<input type="number" name="cash" min="0" step="50" value="0"></label>
    </div>
    {{#if @root.isSyndicate}}<p class="nci-hint">{{localize "NCI.Business.SyndicateCashOnly"}}</p>{{else}}
    <div class="nci-drop" data-gear="join">
      <p class="nci-hint"><i class="fas fa-hand-pointer"></i> {{localize "NCI.Business.GearDrop"}}</p>
      {{#each @root.gearDrafts.join}}
      <div class="nci-gearrow">{{#if img}}<img src="{{img}}" alt="">{{/if}}<span>{{name}}</span><strong>{{value}} eb</strong>{{#if fromActor}}<span class="nci-muted">{{localize "NCI.Business.GearLeaves"}}</span>{{/if}}
        <button type="button" data-action="removeGear" data-form="join" data-index="{{@index}}" title="{{localize 'NCI.Business.GearRemove'}}"><i class="fas fa-xmark"></i></button></div>
      {{/each}}
    </div>
    {{/if}}
    <footer class="nci-footer">
      <button type="button" data-action="join"><i class="fas fa-handshake"></i> {{localize "NCI.Business.Join"}}</button>
      <button type="button" data-action="decline"><i class="fas fa-xmark"></i> {{localize "NCI.Business.Decline"}}</button>
    </footer>
  </div>
  {{/if}}
  {{else}}

  {{#if ../isOverview}}
  <div class="nci-block">
    {{#if isPending}}<p class="nci-warn">{{localize "NCI.Business.AwaitingGM"}}</p>{{/if}}
    {{#if waitingVote}}<p class="nci-warn">{{waitingVote}}</p>{{/if}}
    {{#if isClosed}}<p class="nci-warn">{{closed}}</p>{{/if}}
    <div class="nci-summary">
      {{#if isForming}}<div><span>{{localize "NCI.Business.Escrow"}}</span><strong>{{escrow}} eb</strong></div>{{else}}
      <div><span>{{localize "NCI.Business.Till"}}</span><strong>{{till}} eb</strong></div>
      <div><span>{{localize "NCI.Business.FitOut"}}</span><strong>{{assets}} eb</strong></div>
      <div><span>{{localize "NCI.Business.BookValue"}}</span><strong>{{book}} eb</strong></div>
      {{#if myShare}}<div><span>{{localize "NCI.Business.YourShare"}}</span><strong>{{myShare}} ({{myValue}} eb)</strong></div>{{/if}}
      {{/if}}
    </div>
    {{#if isOpen}}<p class="nci-hint">{{localize "NCI.Business.OpenedOn" date=opened}}</p>{{/if}}
  </div>

  {{#with history}}
  <div class="nci-block nci-history">
    <h3>{{localize "NCI.Business.Standing"}}</h3>
    <div class="nci-standings">
      {{#each standings}}
      <div class="nci-standing{{#if neutral}} nci-neutral{{/if}}">
        <span class="nci-standing-label">{{label}}</span>
        <span class="nci-cells">{{#each cells}}<span class="nci-cell nci-lvl{{level}}" title="{{tip}}"></span>{{/each}}</span>
        <strong class="nci-lvl-text nci-lvl{{level}}">{{now}}</strong>
      </div>
      {{/each}}
    </div>
    {{#if weeks}}
    <h3>{{title}}</h3>
    <div class="nci-chartbox">{{{revenue}}}</div>
    <p class="nci-legend"><span class="nci-key nci-key-takings"></span>{{localize "NCI.Business.Takings"}} <span class="nci-key nci-key-upkeep"></span>{{localize "NCI.Business.Costs"}} <span class="nci-key nci-key-profit"></span>{{localize "NCI.Business.Profit"}}</p>
    {{#if cash}}
    <h3>{{localize "NCI.Business.CashTrend"}}</h3>
    <div class="nci-chartbox">{{{cash}}}</div>
    {{/if}}
    {{else}}
    <p class="nci-hint">{{localize "NCI.Business.NoHistory"}}</p>
    {{/if}}
  </div>
  {{/with}}

  {{#with forming}}
  <div class="nci-block nci-form">
    <h3>{{localize "NCI.Business.Setup"}}</h3>
    <p class="nci-hint">{{localize "NCI.Business.SetupIntro"}} {{setupRange}}</p>
    {{#if waiting}}<p class="nci-warn">{{waiting}}</p>{{/if}}
    {{#if setup}}<p><strong>{{setup}}</strong></p>{{/if}}
    {{#if shortfall}}<p class="nci-warn">{{shortfall}}</p>{{/if}}
    {{#if rollBlocked}}<p class="nci-muted">{{rollBlocked}}</p>{{/if}}
    {{#if canRoll}}<button type="button" data-action="setupRoll"><i class="fas fa-dice-d10"></i> {{localize "NCI.Business.SetupRoll"}}</button>{{/if}}
    {{#if canContribute}}
    <h4>{{localize "NCI.Business.AddMore"}}</h4>
    <div class="nci-grid">
      <label>{{localize "NCI.Business.Cash"}}<input type="number" name="cash" min="0" step="50" value="0"></label>
    </div>
    {{#if @root.isSyndicate}}<p class="nci-hint">{{localize "NCI.Business.SyndicateCashOnly"}}</p>{{else}}
    <div class="nci-drop" data-gear="contribute">
      <p class="nci-hint"><i class="fas fa-hand-pointer"></i> {{localize "NCI.Business.GearDrop"}}</p>
      {{#each @root.gearDrafts.contribute}}
      <div class="nci-gearrow">{{#if img}}<img src="{{img}}" alt="">{{/if}}<span>{{name}}</span><strong>{{value}} eb</strong>{{#if fromActor}}<span class="nci-muted">{{localize "NCI.Business.GearLeaves"}}</span>{{/if}}
        <button type="button" data-action="removeGear" data-form="contribute" data-index="{{@index}}" title="{{localize 'NCI.Business.GearRemove'}}"><i class="fas fa-xmark"></i></button></div>
      {{/each}}
    </div>
    {{/if}}
    <footer class="nci-footer">
      <button type="button" data-action="contribute"><i class="fas fa-coins"></i> {{localize "NCI.Business.Contribute"}}</button>
      <button type="button" data-action="withdraw"><i class="fas fa-rotate-left"></i> {{localize "NCI.Business.Withdraw"}}</button>
    </footer>
    {{/if}}
  </div>
  {{/with}}
  {{/if}}

  {{#if ../isWeek}}
  {{#with week}}
  <div class="nci-block">
    <h3>{{localize "NCI.Business.ThisWeek"}}</h3>
    <p class="nci-hint">{{localize "NCI.Business.WeekRuns" from=from to=to day=closesOn}} {{daysText}}</p>
    {{#with event}}
    <div class="nci-gig">
      <div class="nci-gigtop"><strong>{{name}}</strong>{{#if good}}<span class="nci-up">{{localize "NCI.Business.Opportunity"}}</span>{{else}}<span class="nci-down">{{localize "NCI.Business.Trouble"}}</span>{{/if}}</div>
      <div>{{hint}}</div>
      <div class="nci-muted">{{uses}} {{security}}</div>
      {{#if answered}}<div><strong>{{answered}}</strong></div>{{else}}<div class="nci-muted">{{ifNot}}</div>{{/if}}
      {{#if canAnswer}}<div class="nci-actions"><button type="button" data-action="respond"><i class="fas fa-dice-d10"></i> {{localize "NCI.Business.Answer"}}</button></div>{{/if}}
    </div>
    {{/with}}
    <table class="nci-market">
      <thead><tr><th>{{localize "NCI.Business.ActionLabel"}}</th><th></th><th class="nci-slots{{#if noSlots}} nci-slots-none{{/if}}">{{slotsFree}}</th></tr></thead>
      <tbody>
        {{#each actions}}
        <tr>
          <td><strong>{{name}}</strong><div class="nci-muted">{{hint}}</div></td>
          <td>{{#if taken}}{{taken}}{{/if}}{{#if bonus}}<div class="nci-up">{{bonus}}</div>{{/if}}</td>
          <td class="nci-rowbtns nci-endbtns">
            {{#if canRoll}}<button type="button" data-action="actionRoll" data-id="{{id}}"><i class="fas fa-dice-d10"></i> {{localize "NCI.Business.TakeSlot"}}</button>{{/if}}
            {{#if canHelp}}<button type="button" data-action="helpRoll" data-id="{{id}}" title="{{@root.business.terms.HelpHint}}"><i class="fas fa-hands-helping"></i> {{localize "NCI.Business.Help"}}</button>{{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{#if helped}}<p class="nci-muted">{{helped}}</p>{{/if}}
    <p class="nci-hint">{{unworkedNote}}</p>
  </div>
  {{#if notOfficer}}<p class="nci-warn">{{notOfficer}}</p>{{/if}}
  {{#with info}}
  <div class="nci-block">
    <h3>{{localize "NCI.Company.Information"}}</h3>
    <p class="nci-hint">{{auditHint}}</p>
    <p>{{audit}}</p>
    {{#if canAudit}}<button type="button" data-action="auditRoll"><i class="fas fa-magnifying-glass-dollar"></i> {{localize "NCI.Company.Audit"}}</button>{{/if}}
    <p class="nci-hint">{{diligenceHint}}</p>
    {{#if canDiligence}}
    <div class="nci-actions nci-form">
      <label>{{localize "NCI.Company.Target"}} <input type="text" name="targetName" maxlength="60"></label>
      <button type="button" data-action="diligenceRoll"><i class="fas fa-binoculars"></i> {{localize "NCI.Company.Diligence"}}</button>
    </div>
    {{/if}}
    {{#if intel.length}}
    <table class="nci-market"><tbody>
      {{#each intel}}<tr><td><strong>{{name}}</strong> <span class="nci-muted">{{date}}</span></td><td>{{found}}</td></tr>{{/each}}
    </tbody></table>
    {{/if}}
  </div>
  {{/with}}
  {{else}}
  <p class="nci-empty">{{localize "NCI.Business.NotOpenYet"}}</p>
  {{/with}}
  {{/if}}

  {{#if ../isProjects}}
  {{#with projects}}
  <div class="nci-block">
    <h3>{{localize "NCI.Business.Projects"}}</h3>
    <p class="nci-hint">{{@root.business.terms.ProjectIntro}}</p>
    <div class="nci-standing nci-capacity">
      <span class="nci-standing-label">{{localize "NCI.Business.State.capacity"}}</span>
      <span class="nci-capbar" title="{{capacity.text}}"><span class="nci-capnow" style="width: {{capacity.now}}%"></span><span class="nci-capnext" style="width: {{capacity.next}}%"></span></span>
      <span>{{capacity.text}} <span class="nci-muted">{{capacity.nextText}}</span></span>
    </div>
  </div>

  {{#with active}}
  <div class="nci-block nci-form">
    <h3>{{localize "NCI.Project.UnderWay"}}</h3>
    <div class="nci-gigtop"><strong>{{name}}</strong><span class="nci-muted">{{started}}</span></div>
    <div class="nci-progress" title="{{progress}}"><span style="width: {{pct}}%"></span></div>
    <p>{{progress}} <span class="nci-muted">{{effect}}</span></p>
    <p class="nci-muted">{{crew}}</p>
    {{#if canAdd}}
    <div class="nci-hirerow">
      <span class="nci-muted">{{localize "NCI.Project.AddHint"}}</span>
      <label>{{localize "NCI.Business.DaysToAdd"}} <input type="number" name="days" min="1" max="{{max}}" step="1" value="1"></label>
      <button type="button" data-action="addDays" data-id="{{id}}"><i class="fas fa-hammer"></i> {{localize "NCI.Business.AddDays"}}</button>
    </div>
    {{/if}}
  </div>
  {{/with}}

  <div class="nci-block">
    <h3>{{localize "NCI.Project.Choose"}}</h3>
    {{#if pending}}<p class="nci-warn">{{pending}}</p>{{/if}}
    {{#if running}}<p class="nci-muted">{{running}}</p>{{/if}}
    <table class="nci-market">
      <thead><tr><th>{{localize "NCI.Project.Project"}}</th><th>{{localize "NCI.Project.Effect.Label"}}</th><th class="num">{{localize "NCI.Project.Cost"}}</th><th class="num">{{localize "NCI.Project.Days"}}</th><th class="nci-slots{{#if noDays}} nci-slots-none{{/if}}">{{daysFree}}</th></tr></thead>
      <tbody>
        {{#each kinds}}
        <tr>
          <td><strong>{{name}}</strong><div class="nci-muted">{{hint}}</div></td>
          <td>{{effect}}{{#if blocked}}<div class="nci-warn">{{blocked}}</div>{{/if}}</td>
          <td class="num">{{cost}}</td>
          <td class="num">{{days}}</td>
          <td class="nci-rowbtns nci-endbtns">{{#if canPropose}}<button type="button" data-action="proposeProject" data-kind="{{kind}}"><i class="fas fa-helmet-safety"></i> {{localize "NCI.Project.Propose"}}</button>{{/if}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  {{#if done.length}}
  <div class="nci-block">
    <h3>{{localize "NCI.Project.Finished"}}</h3>
    <table class="nci-market">
      <thead><tr><th>{{localize "NCI.Project.Done"}}</th><th>{{localize "NCI.Project.Project"}}</th><th>{{localize "NCI.Project.Result.Label"}}</th><th class="num">{{localize "NCI.Project.Cost"}}</th><th class="num">{{localize "NCI.Project.Days"}}</th><th>{{localize "NCI.Project.CrewLabel"}}</th></tr></thead>
      <tbody>
        {{#each done}}<tr><td class="nci-muted">{{done}}<div>{{localize "NCI.Project.Since" date=started}}</div></td><td><strong>{{name}}</strong></td><td>{{result}}</td><td class="num">{{cost}}</td><td class="num">{{days}}</td><td class="nci-muted">{{crew}}</td></tr>{{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}
  {{else}}
  <p class="nci-empty">{{localize "NCI.Business.NotOpenYet"}}</p>
  {{/with}}
  {{/if}}

  {{#if ../isGrowth}}
  {{#with growth}}
  <div class="nci-block">
    <h3>{{localize "NCI.Business.Growth"}}</h3>
    <p class="nci-hint">{{localize "NCI.Business.GrowthNow" stage=stage}}</p>
    {{#if available}}
    <h4>{{localize "NCI.Business.NextStage" stage=next}}</h4>
    <table class="nci-market"><tbody>
      {{#each items}}<tr><td>{{#if met}}<i class="fas fa-check nci-up"></i>{{else}}<i class="fas fa-xmark nci-down"></i>{{/if}} {{label}}</td><td>{{have}}</td></tr>{{/each}}
    </tbody></table>
    <p class="nci-hint">{{gains}}</p>
    {{#if pending}}<p class="nci-warn">{{pending}}</p>{{/if}}
    {{#with listing}}
    <p><strong>{{valuation}}</strong>{{#if history}} <span class="nci-muted">{{history}}</span>{{/if}}</p>
    {{#if refused}}<p class="nci-warn">{{refused}}</p>{{/if}}
    {{#if canPropose}}
    <div class="nci-hirerow nci-form">
      <label>{{localize "NCI.Listing.Float"}} <select name="float">{{#each floats}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
      <span></span>
      <button type="button" data-action="proposeListing"><i class="fas fa-chart-line"></i> {{localize "NCI.Listing.Propose"}}</button>
    </div>
    <p class="nci-hint">{{feeText}}</p>
    {{/if}}
    {{#if awaiting}}<p class="nci-warn">{{awaiting}}</p>{{/if}}
    {{#if prospectus}}<p><strong>{{prospectus}}</strong></p>{{/if}}
    {{#if parts.length}}
    <table class="nci-market"><tbody>
      {{#each parts}}
      <tr><td>{{label}}</td><td>{{result}}</td>
        <td class="nci-rowbtns">{{#if canRoll}}<button type="button" class="nci-labelled" data-action="prospectusRoll" data-part="{{part}}"><i class="fas fa-dice-d10"></i> {{localize "NCI.Charter.Roll"}}</button>{{/if}}</td></tr>
      {{/each}}
    </tbody></table>
    {{/if}}
    {{#if ready}}<p class="nci-up"><strong>{{ready}}</strong></p>{{/if}}
    {{#if scheduled}}<p class="nci-up"><strong>{{scheduled}}</strong></p>{{/if}}
    {{#if listed}}<p class="nci-up"><strong>{{listed}}</strong></p>{{/if}}
    {{/with}}
    {{#with charter}}
    <p class="nci-hint">{{localize "NCI.Charter.SectorLine" sector=sector}} {{range}}</p>
    {{#if refused}}<p class="nci-warn">{{refused}}</p>{{/if}}
    {{#if kept}}<p class="nci-hint">{{kept}}</p>{{/if}}
    {{#if canPropose}}
    <div class="nci-hirerow nci-form">
      <label>{{localize "NCI.Charter.Ticker"}} <input type="text" name="ticker" maxlength="5"></label>
      <span></span>
      <button type="button" data-action="proposeCharter"><i class="fas fa-file-signature"></i> {{localize "NCI.Charter.Propose"}}</button>
    </div>
    {{/if}}
    {{#if agreed}}<p><strong>{{agreed}}</strong></p>{{/if}}
    {{#if parts.length}}
    <table class="nci-market"><tbody>
      {{#each parts}}
      <tr><td>{{label}}</td><td>{{result}}</td>
        <td class="nci-rowbtns">{{#if canRoll}}<button type="button" class="nci-labelled" data-action="charterRoll" data-part="{{part}}"><i class="fas fa-dice-d10"></i> {{localize "NCI.Charter.Roll"}}</button>{{/if}}</td></tr>
      {{/each}}
    </tbody></table>
    {{/if}}
    {{#if awaiting}}<p class="nci-warn">{{awaiting}}</p>{{/if}}
    {{#if funding}}
    <p><strong>{{funding}}</strong></p>
    {{#if canFund}}
    <div class="nci-actions nci-form">
      <label>{{localize "NCI.Business.Cash"}} <input type="number" name="cash" min="1" step="100" value="0"></label>
      <button type="button" data-action="charterFund"><i class="fas fa-coins"></i> {{localize "NCI.Charter.Fund"}}</button>
    </div>
    {{/if}}
    {{/if}}
    {{else}}
    {{#if agreed}}<p><strong>{{agreed}}</strong></p>{{/if}}
    {{#if retry}}<p class="nci-warn">{{retry}}</p>{{/if}}
    {{#if canPropose}}<button type="button" data-action="proposeStepUp"><i class="fas fa-stairs"></i> {{localize "NCI.Business.ProposeStepUp"}}</button>{{/if}}
    {{#if canRoll}}<button type="button" data-action="stepUpRoll"><i class="fas fa-dice-d10"></i> {{localize "NCI.Business.StepUpRoll"}}</button>{{/if}}
    {{/with}}
    {{else}}
    <p class="nci-muted">{{later}}</p>
    {{/if}}
  </div>
  {{else}}
  <p class="nci-empty">{{localize "NCI.Business.NotOpenYet"}}</p>
  {{/with}}
  {{/if}}

  {{#if ../isStaff}}
  {{#with staff}}
  <div class="nci-block">
    <h3>{{localize "NCI.Staff.Title"}}</h3>
    <p class="nci-hint">{{localize "NCI.Staff.Intro"}}</p>
    {{#if pending}}<p class="nci-warn">{{pending}}</p>{{/if}}
    <table class="nci-market">
      <thead><tr><th>{{localize "NCI.Staff.Employee"}}</th><th>{{localize "NCI.Staff.PostLabel"}}</th><th>{{localize "NCI.Staff.Skill"}}</th><th>{{localize "NCI.Staff.LoyaltyLabel"}}</th><th class="num">{{localize "NCI.Staff.Wage"}}</th><th class="nci-slots{{#if noRoles}} nci-slots-none{{/if}}">{{openRoles}}</th></tr></thead>
      <tbody>
        {{#each rows}}
        <tr>
          <td><strong>{{{who}}}</strong> <span class="nci-muted">{{source}}</span><div class="nci-muted">{{status}}</div>{{#if owed}}<div class="nci-warn">{{owed}}</div>{{/if}}{{#each notes}}<div class="nci-warn">{{this}}</div>{{/each}}</td>
          <td>{{post}} <span class="nci-muted">{{level}}</span></td>
          <td>{{skill}} <strong>{{base}}</strong></td>
          <td>{{#if loyalty}}<span class="nci-loyal nci-loyal-{{loyaltyBand}}">{{loyalty}}</span>{{else}}<span class="nci-muted">&mdash;</span>{{/if}}</td>
          <td class="num">{{wage}}</td>
          <td class="nci-rowbtns nci-endbtns">
            {{#if canManage}}<button type="button" class="nci-labelled" data-action="openEmployee" data-id="{{id}}"><i class="fas fa-id-badge"></i> {{localize "NCI.Staff.Manage"}}</button>{{/if}}
            {{#if canFire}}<button type="button" class="nci-labelled" data-action="proposeFire" data-id="{{id}}"><i class="fas fa-xmark"></i> {{localize "NCI.Staff.Withdraw"}}</button>{{/if}}
          </td>
        </tr>
        {{else}}
        <tr><td colspan="6" class="nci-empty">{{localize "NCI.Staff.None"}}</td></tr>
        {{/each}}
      </tbody>
    </table>
    <p class="nci-hint">{{localize "NCI.Staff.OvertimeHint"}} {{localize "NCI.Staff.LoyaltyHint"}}</p>
  </div>
  <div class="nci-block nci-form">
    <h3>{{localize "NCI.Staff.Posts"}}</h3>
    <table class="nci-market"><tbody>
      {{#each posts}}
      <tr>
        <td><strong>{{label}}</strong></td>
        <td class="nci-muted">{{hint}}</td>
        <td class="nci-rowbtns">{{#if canHire}}<button type="button" class="nci-labelled" data-action="openHire" data-post="{{value}}"><i class="fas fa-user-plus"></i> {{localize "NCI.Staff.Hire"}}</button>{{/if}}</td>
      </tr>
      {{/each}}
    </tbody></table>
    {{#if noOpen}}<p class="nci-muted">{{noOpen}}</p>{{/if}}
    <p class="nci-hint">{{recruitText}}</p>
  </div>
  {{#if applicants.length}}
  <div class="nci-block">
    <h3>{{localize "NCI.Staff.Applicants"}}</h3>
    {{#each applicants}}
    <div class="nci-applicants">
      <div class="nci-gigtop"><strong>{{label}}</strong>{{#if canVet}}<button type="button" class="nci-labelled" data-action="vetApplicants" data-post="{{post}}"><i class="fas fa-magnifying-glass"></i> {{localize "NCI.Staff.Vet"}}</button>{{/if}}</div>
      {{#if canVet}}<p class="nci-hint">{{vetText}}</p>{{/if}}
      {{#each people}}
      <div class="nci-gig">
        <div class="nci-gigtop"><strong>{{name}}</strong><span class="nci-muted">{{level}}{{#if base}} ({{base}}){{/if}}</span></div>
        <div class="nci-muted">{{terms}}</div>
        <div class="{{#if bad}}nci-warn{{else}}nci-muted{{/if}}">{{vetted}}</div>
        <div class="nci-actions">
          {{#if canHire}}<button type="button" data-action="proposeHire" data-id="{{id}}"><i class="fas fa-user-plus"></i> {{localize "NCI.Staff.ProposeHire"}}</button>{{/if}}
          {{#if canReject}}<button type="button" data-action="rejectApplicant" data-id="{{id}}"><i class="fas fa-user-xmark"></i> {{localize "NCI.Staff.Reject"}}</button>{{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    {{/each}}
  </div>
  {{/if}}
  {{/with}}
  {{/if}}

  {{#if ../isLedger}}
  {{#with ledger}}
  <div class="nci-block nci-form">
    <h3>{{localize "NCI.Business.Draws"}}</h3>
    <p class="nci-hint">{{allowanceText}}</p>
    {{#if canDraw}}
    <label>{{localize "NCI.Business.DrawAmount"}}<input type="number" name="amount" min="1" max="{{allowance}}" step="1" value="{{allowance}}" class="nci-days"></label>
    <button type="button" data-action="draw"><i class="fas fa-hand-holding-dollar"></i> {{localize "NCI.Business.Draw"}}</button>
    {{/if}}
  </div>
  {{#if canTopUp}}
  <div class="nci-block nci-form">
    <h3>{{localize "NCI.Business.AddMore"}}</h3>
    <p class="nci-hint">{{@root.business.terms.TopUpHint}}</p>
    <div class="nci-grid">
      <label>{{localize "NCI.Business.Cash"}}<input type="number" name="cash" min="0" step="50" value="0"></label>
    </div>
    {{#if @root.isSyndicate}}<p class="nci-hint">{{localize "NCI.Business.SyndicateCashOnly"}}</p>{{else}}
    <div class="nci-drop" data-gear="contribute">
      <p class="nci-hint"><i class="fas fa-hand-pointer"></i> {{localize "NCI.Business.GearDrop"}}</p>
      {{#each @root.gearDrafts.contribute}}
      <div class="nci-gearrow">{{#if img}}<img src="{{img}}" alt="">{{/if}}<span>{{name}}</span><strong>{{value}} eb</strong>{{#if fromActor}}<span class="nci-muted">{{localize "NCI.Business.GearLeavesForGood"}}</span>{{/if}}
        <button type="button" data-action="removeGear" data-form="contribute" data-index="{{@index}}" title="{{localize 'NCI.Business.GearRemove'}}"><i class="fas fa-xmark"></i></button></div>
      {{/each}}
    </div>
    {{/if}}
    <button type="button" data-action="contribute"><i class="fas fa-coins"></i> {{localize "NCI.Business.Contribute"}}</button>
  </div>
  {{/if}}
  {{#with money}}
  <div class="nci-block nci-form">
    <h3>{{localize "NCI.Business.Loans"}}</h3>
    {{#each loans}}
    <div class="nci-gig">
      <div>{{text}}{{#if missed}} <span class="nci-down">{{missed}}</span>{{/if}}</div>
      {{#if canRepay}}<div class="nci-actions"><input type="number" name="repay" min="1" max="{{max}}" step="10" value="{{max}}" class="nci-days"><button type="button" data-action="repayLoan" data-id="{{id}}">{{localize "NCI.Business.Repay"}}</button></div>{{/if}}
    </div>
    {{/each}}
    {{#if pending}}<p class="nci-warn">{{pending}}</p>{{/if}}
    <p class="nci-hint">{{fixerText}}</p>
    {{#if canFixer}}
    <label>{{localize "NCI.Business.LoanAmount"}}<input type="number" name="loanAmount" min="100" max="{{fixerLimit}}" step="100" value="500" class="nci-days"></label>
    <button type="button" data-action="proposeFixerLoan"><i class="fas fa-handshake-simple"></i> {{localize "NCI.Business.ProposeFixer"}}</button>
    {{/if}}
    <p class="nci-hint">{{bankText}}</p>
    {{#if bankRetry}}<p class="nci-warn">{{bankRetry}}</p>{{/if}}
    {{#if canProposeBank}}<button type="button" data-action="proposeBankLoan"><i class="fas fa-building-columns"></i> {{localize "NCI.Business.ProposeBank"}}</button>{{/if}}
    {{#if canRollBank}}
    <label>{{localize "NCI.Business.LoanAmount"}}<input type="number" name="bankAmount" min="100" step="100" value="1000" class="nci-days"></label>
    <button type="button" data-action="loanRoll"><i class="fas fa-dice-d10"></i> {{localize "NCI.Business.BankRoll"}}</button>
    {{/if}}
  </div>
  {{/with}}
  {{#with report}}
  <div class="nci-block">
    <h3>{{localize "NCI.Company.Report"}}</h3>
    <p class="nci-hint">{{text}} {{localize "NCI.Company.ReportHint"}}</p>
    {{#if prepared}}<p><strong>{{prepared}}</strong></p>{{/if}}
    {{#if canPrepare}}<button type="button" data-action="reportRoll"><i class="fas fa-file-invoice-dollar"></i> {{localize "NCI.Company.Prepare"}}</button>{{/if}}
  </div>
  {{/with}}
  {{#if reports}}
  <div class="nci-block">
    <h3>{{localize "NCI.Company.Reports"}}</h3>
    {{#if reports.length}}
    <table class="nci-market">
      <thead><tr><th>{{localize "NCI.Company.ReportLabel"}}</th><th class="num">{{localize "NCI.Business.Takings"}}</th><th class="num">{{localize "NCI.Business.Upkeep"}}</th><th class="num">{{localize "NCI.Business.Profit"}}</th><th class="num">{{localize "NCI.Company.Reported"}}</th><th></th></tr></thead>
      <tbody>
        {{#each reports}}<tr class="nci-row" data-action="openReport" data-index="{{index}}" title="{{localize 'NCI.Report.Open'}}"><td>#{{index}} <span class="nci-muted">{{when}}</span></td><td class="num">{{takings}}</td><td class="num">{{upkeep}}</td><td class="num {{cls}}">{{profit}}</td><td class="num">{{reported}}</td><td class="nci-muted">{{prep}}</td></tr>{{/each}}
      </tbody>
    </table>
    {{else}}<p class="nci-empty">{{localize "NCI.Company.NoReports"}}</p>{{/if}}
  </div>
  {{/if}}
  <div class="nci-block">
    <h3>{{localize "NCI.Business.Weeks"}}</h3>
    {{#if digests.length}}
    <p class="nci-hint">{{localize "NCI.Business.WeeksHint"}}</p>
    <table class="nci-market">
      <thead><tr><th>{{localize "NCI.Business.WeekLabel"}}</th><th class="num">{{localize "NCI.Business.Takings"}}</th><th class="num">{{localize "NCI.Business.Upkeep"}}</th><th class="num">{{localize "NCI.Business.Wages"}}</th><th class="num">{{localize "NCI.Business.Other"}}</th><th class="num">{{localize "NCI.Business.Profit"}}</th><th class="num">{{localize "NCI.Business.Till"}}</th></tr></thead>
      <tbody>
        {{#each digests}}
        <tr class="nci-row" data-action="openCashbook" data-index="{{index}}" title="{{localize 'NCI.Cashbook.Open'}}"><td>{{week}}<div class="nci-muted">{{dates}}</div><div class="nci-muted">{{actions}}</div>{{#if event}}<div class="nci-muted">{{event}}</div>{{/if}}{{#if loans}}<div class="nci-muted">{{loans}}</div>{{/if}}{{#if wages}}<div class="nci-muted">{{wages}}</div>{{/if}}{{#if people}}<div class="nci-muted">{{people}}</div>{{/if}}{{#if gig}}<div class="nci-muted">{{gig}}</div>{{/if}}</td><td class="num {{takingsCls}}">{{takings}}</td><td class="num {{upkeepCls}}">{{upkeep}}</td><td class="num {{wagesCls}}">{{paidWages}}</td><td class="num {{otherCls}}">{{other}}</td><td class="num {{cls}}">{{profit}}</td><td class="num">{{till}}</td></tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}<p class="nci-empty">{{localize "NCI.Business.NoWeeks"}}</p>{{/if}}
  </div>
  <div class="nci-block">
    <h3>{{localize "NCI.Business.LedgerTitle"}}</h3>
    {{#if entries.length}}
    <table class="nci-market"><tbody>
      {{#each entries}}<tr><td class="nci-muted">{{date}}</td><td>{{what}}</td><td class="{{cls}}">{{amount}}</td></tr>{{/each}}
    </tbody></table>
    {{else}}<p class="nci-empty">{{localize "NCI.Business.NoLedger"}}</p>{{/if}}
  </div>
  {{/with}}
  {{/if}}

  {{#if ../isPartners}}
  {{#with partners}}
  <div class="nci-block">
    <h3>{{@root.business.terms.CapTable}}</h3>
    <table class="nci-market">
      <thead><tr><th>{{@root.business.terms.Partner}}</th><th>{{@root.business.terms.Units}}</th><th>{{localize "NCI.Business.Share"}}</th><th></th></tr></thead>
      <tbody>
        {{#each rows}}
        <tr>
          <td><strong>{{{who}}}</strong> <span class="nci-muted">{{status}}{{#if voting}} &middot; {{voting}}{{/if}}{{#if officer}} &middot; {{officer}}{{/if}}</span>
            <div class="nci-muted">{{put}}{{#if gear}} &middot; {{gear}}{{/if}}</div>
            {{#if heir}}<div class="nci-muted">{{heir}}</div>{{/if}}
            {{#if leaving}}<div class="nci-warn">{{leaving}}</div>{{/if}}
          </td>
          <td>{{units}}</td>
          <td>{{share}}</td>
          <td class="nci-rowbtns">{{#if buyout}}<button type="button" data-action="buyout" data-id="{{actorId}}">{{buyout}}</button>{{/if}}
            {{#if canElect}}<button type="button" class="nci-labelled" data-action="proposeElect" data-id="{{actorId}}"><i class="fas fa-user-tie"></i> {{localize "NCI.Company.Elect"}}</button>{{/if}}
            {{#if canDismiss}}<button type="button" class="nci-labelled" data-action="proposeDismiss" data-id="{{actorId}}"><i class="fas fa-user-slash"></i> {{localize "NCI.Company.Dismiss"}}</button>{{/if}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{#if unitValue}}<p class="nci-hint">{{unitValue}}</p>{{/if}}
    {{#if isCompany}}<p class="nci-hint">{{localize "NCI.Company.OfficersHint"}}</p>{{/if}}
  </div>
  <div class="nci-block nci-form">
    <h3>{{localize "NCI.Business.AgreementTitle"}}</h3>
    <ul>{{#each agreement}}<li>{{this}}</li>{{/each}}</ul>
    {{#if canSetHeir}}
    <label>{{localize "NCI.Business.Heir"}}
      <select name="heirId">{{#each heirOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <button type="button" data-action="setHeir"><i class="fas fa-save"></i> {{localize "NCI.Business.SaveHeir"}}</button>
    <p class="nci-hint">{{@root.business.terms.HeirHint}}</p>
    {{/if}}
  </div>
  {{#with investors}}
  <div class="nci-block nci-form">
    <h3>{{localize "NCI.Business.Investors"}}</h3>
    {{#if later}}<p class="nci-muted">{{later}}</p>{{else}}
    {{#if holders}}<p class="nci-muted">{{localize "NCI.Business.AngelHolders" names=holders}}</p>{{/if}}
    {{#if canInvite}}
    <div class="nci-grid">
      <label>{{localize "NCI.Business.Investor"}}<select name="investor">{{#each candidates}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
      <label>{{localize "NCI.Business.InvestAmount"}}<input type="number" name="investAmount" min="100" step="100" value="1000"></label>
      <label>{{priceLabel}}<input type="number" name="investPrice" min="0" step="0.01" placeholder="{{bookPrice}}"></label>
    </div>
    <button type="button" data-action="proposeInvestor"><i class="fas fa-user-plus"></i> {{localize "NCI.Business.ProposeInvestor"}}</button>
    {{/if}}
    <p class="nci-hint">{{@root.business.terms.AngelIntro}}</p>
    {{#if angel}}<p><strong>{{angel}}</strong></p>{{/if}}
    {{#if angelRetry}}<p class="nci-warn">{{angelRetry}}</p>{{/if}}
    {{#if canSeekAngel}}<button type="button" data-action="proposeAngel"><i class="fas fa-feather"></i> {{localize "NCI.Business.ProposeAngel"}}</button>{{/if}}
    {{#if canPitch}}<button type="button" data-action="angelRoll"><i class="fas fa-dice-d10"></i> {{localize "NCI.Business.AngelRoll"}}</button>{{/if}}
    {{/if}}
  </div>
  {{/with}}
  <div class="nci-block">
    <h3>{{localize "NCI.Business.Decisions"}}</h3>
    {{#each proposals}}
    <div class="nci-gig nci-proposal">
      <div class="nci-gigtop"><strong>{{text}}</strong><span class="nci-muted">{{rule}}</span></div>
      <div class="nci-votes">
        {{#each voters}}<span class="nci-vote">{{{who}}}<span class="nci-vote-{{state}}">{{label}}</span></span>{{/each}}
      </div>
      {{#if canVote}}
      <div class="nci-actions">
        <button type="button" data-action="vote" data-id="{{id}}" data-yes="true"><i class="fas fa-check"></i> {{localize "NCI.Business.VoteYes"}}</button>
        <button type="button" data-action="vote" data-id="{{id}}" data-yes="false"><i class="fas fa-xmark"></i> {{localize "NCI.Business.VoteNo"}}</button>
      </div>
      {{/if}}
    </div>
    {{/each}}
    {{#if canPropose}}<div class="nci-actions">
      <button type="button" data-action="proposeClose"><i class="fas fa-door-closed"></i> {{localize "NCI.Business.ProposeClose"}}</button>
      {{#if canLeave}}<button type="button" data-action="leave"><i class="fas fa-person-walking-arrow-right"></i> {{localize "NCI.Business.Leave"}}</button>{{/if}}
    </div>{{else}}{{#if canLeave}}<div class="nci-actions">
      <button type="button" data-action="leave"><i class="fas fa-person-walking-arrow-right"></i> {{localize "NCI.Business.Leave"}}</button>
    </div>{{/if}}{{/if}}
    <p class="nci-hint">{{@root.business.terms.DecisionsHint}}</p>
  </div>
  {{/with}}
  {{/if}}
  {{/if}}
  {{/with}}
</section>
