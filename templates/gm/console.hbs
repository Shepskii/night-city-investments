<section class="nci-console">
  <nav class="nci-tabs nci-groups">
    {{#each groups}}
    <button type="button" data-action="switchTab" data-group="{{id}}" class="{{#if active}}active{{/if}}">{{label}}{{#if count}} <span class="nci-count">{{count}}</span>{{/if}}</button>
    {{/each}}
  </nav>
  {{#if subTabs.length}}
  <nav class="nci-tabs nci-subtabs">
    {{#each subTabs}}
    <button type="button" data-action="switchTab" data-tab="{{id}}" class="{{#if active}}active{{/if}}">{{label}}{{#if count}} <span class="nci-count">{{count}}</span>{{/if}}</button>
    {{/each}}
  </nav>
  {{/if}}

  {{#unless activeGM}}<p class="nci-warn">{{localize "NCI.Errors.NotActiveGM"}}</p>{{/unless}}

  {{#if isPending}}{{> "modules/night-city-investments/templates/gm/console/pending.hbs"}}{{/if}}
  {{#if isMarket}}{{> "modules/night-city-investments/templates/gm/console/market.hbs"}}{{/if}}
  {{#if isEvents}}{{> "modules/night-city-investments/templates/gm/console/events.hbs"}}{{/if}}
  {{#if isActions}}{{> "modules/night-city-investments/templates/gm/console/actions.hbs"}}{{/if}}
  {{#if isCompanies}}{{> "modules/night-city-investments/templates/gm/console/companies.hbs"}}{{/if}}
  {{#if isFunds}}{{> "modules/night-city-investments/templates/gm/console/funds.hbs"}}{{/if}}
  {{#if isBrokers}}{{> "modules/night-city-investments/templates/gm/console/brokers.hbs"}}{{/if}}
  {{#if isGigs}}{{> "modules/night-city-investments/templates/gm/console/gigs.hbs"}}{{/if}}
  {{#if isHeat}}{{> "modules/night-city-investments/templates/gm/console/heat.hbs"}}{{/if}}
  {{#if isBusinesses}}{{> "modules/night-city-investments/templates/gm/console/businesses.hbs"}}{{/if}}
  {{#if isJobMarket}}{{> "modules/night-city-investments/templates/gm/console/jobMarket.hbs"}}{{/if}}
  {{#if isSyndicates}}{{> "modules/night-city-investments/templates/gm/console/syndicates.hbs"}}{{/if}}
  {{#if isProduction}}{{> "modules/night-city-investments/templates/gm/console/production.hbs"}}{{/if}}
  {{#if isFactions}}{{> "modules/night-city-investments/templates/gm/console/factions.hbs"}}{{/if}}
  {{#if isTools}}{{> "modules/night-city-investments/templates/gm/console/tools.hbs"}}{{/if}}
</section>
