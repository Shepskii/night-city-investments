<div class="nci-editor">
  <div class="nci-grid">
    <label>{{localize "NCI.Editor.Name"}}<input type="text" name="name" value="{{fund.name}}" required></label>
    <label>{{localize "NCI.Editor.Ticker"}}<input type="text" name="ticker" value="{{fund.ticker}}" maxlength="6" required></label>
    <label>{{localize "NCI.Fund.Kind"}}
      <select name="kind">{{selectOptions kinds selected=fund.kind}}</select>
    </label>
    <label>{{localize "NCI.Fund.MinBuy"}}<input type="number" name="minBuy" value="{{fund.minBuy}}" min="0" step="10"></label>
    <label>{{localize "NCI.FundEditor.ExpensePct"}}<input type="number" name="expensePct" value="{{fund.expensePct}}" min="0" max="5" step="0.05"></label>
    <label>{{localize "NCI.FundEditor.LoadBps"}}<input type="number" name="loadBps" value="{{fund.loadBps}}" min="0" max="500" step="5"></label>
    <label>{{localize "NCI.FundEditor.ExitBps"}}<input type="number" name="exitBps" value="{{fund.exitBps}}" min="0" max="500" step="5"></label>
    {{#if isNew}}<label>{{localize "NCI.FundEditor.InitialNav"}}<input type="number" name="initialNav" value="{{fund.initialNav}}" min="1" step="0.01"></label>{{/if}}
    <label>{{localize "NCI.FundEditor.Rebalance"}}
      <select name="rebalance">{{selectOptions rebalances selected=fund.rebalance}}</select>
    </label>
    <label>{{localize "NCI.FundEditor.AlphaPct"}}<input type="number" name="alphaPct" value="{{fund.alphaPct}}" min="-10" max="10" step="0.25"></label>
    <label>{{localize "NCI.FundEditor.Distribution"}}
      <select name="distribution">{{selectOptions distributions selected=fund.distribution}}</select>
    </label>
    <label>{{localize "NCI.FundEditor.DistributionFrequency"}}
      <select name="distributionFrequency">{{selectOptions distributionFrequencies selected=fund.distributionFrequency}}</select>
    </label>
    <label>{{localize "NCI.FundEditor.RedeemDelay"}}<input type="number" name="redeemDelay" value="{{fund.redeemDelay}}" min="0" max="10" step="1"></label>
  </div>
  <p class="nci-hint">{{localize "NCI.FundEditor.RebalanceHint"}}</p>
  <p class="nci-hint">{{localize "NCI.FundEditor.DistributionHint"}}</p>

  <label class="wide">{{localize "NCI.FundEditor.Components"}}
    <textarea name="components" rows="6" required>{{components}}</textarea>
    <span class="nci-hint">{{localize "NCI.FundEditor.ComponentsHint"}}</span>
  </label>

  <label class="wide">{{localize "NCI.Editor.Description"}}
    <textarea name="description" rows="3">{{fund.description}}</textarea>
  </label>

  <footer class="nci-footer">
    <button type="submit"><i class="fas fa-save"></i> {{localize "NCI.Editor.Save"}}</button>
    <button type="button" data-action="cancel">{{localize "NCI.Editor.Cancel"}}</button>
  </footer>
</div>
