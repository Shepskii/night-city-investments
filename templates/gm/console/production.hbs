{{#with production}}
<div class="nci-block">
  <p class="nci-hint">{{localize "NCI.Production.GMHint"}}</p>
  <div class="nci-actions" data-production-add>
    <label class="nci-inline">{{localize "NCI.Production.BusinessType"}} <select name="productionArchetype" data-production-archetype>{{#each archetypes}}<option value="{{id}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label class="nci-inline">{{localize "NCI.Production.AddLabel"}} <input type="text" name="uuid" placeholder="{{localize "NCI.Production.AddPlaceholder"}}" data-production-drop></label>
    <button type="button" data-action="productionAdd"><i class="fas fa-plus"></i> {{localize "NCI.Production.Add"}}</button>
  </div>

  {{#if rows.length}}
  <table class="nci-market">
    <thead><tr><th>{{localize "NCI.Production.Item"}}</th><th>{{localize "NCI.Production.Type"}}</th><th>{{localize "NCI.Production.Price"}}</th><th>{{localize "NCI.Production.Category"}}</th><th></th></tr></thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td><strong>{{name}}</strong>{{#if illegal}} <span class="nci-down">{{localize "NCI.Production.Illegal"}}</span>{{/if}}</td>
        <td>{{typeName}}</td>
        <td>{{priceText}} eb</td>
        <td>{{tier}}{{#if dv}} <span class="nci-muted">DV {{dv}}</span>{{/if}}</td>
        <td class="nci-rowbtns nci-endbtns">
          <button type="button" data-action="productionIllegal" data-uuid="{{uuid}}" data-illegal="{{illegal}}">{{#if illegal}}{{localize "NCI.Production.MarkLegal"}}{{else}}{{localize "NCI.Production.MarkIllegal"}}{{/if}}</button>
          <button type="button" data-action="productionRemove" data-uuid="{{uuid}}" title="{{localize 'NCI.Production.Remove'}}"><i class="fas fa-trash"></i></button>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="nci-empty">{{localize "NCI.Production.NoItems"}}</p>
  {{/if}}

  {{#if removed.length}}
  <h3>{{localize "NCI.Production.Removed"}}</h3>
  <table class="nci-market">
    <tbody>
      {{#each removed}}
      <tr><td>{{name}}</td><td class="nci-rowbtns nci-endbtns"><button type="button" data-action="productionRestore" data-uuid="{{uuid}}"><i class="fas fa-rotate-left"></i> {{localize "NCI.Production.Restore"}}</button></td></tr>
      {{/each}}
    </tbody>
  </table>
  {{/if}}
</div>
<hr class="nci-rule">

<div class="nci-block nci-form" data-contract-form>
  <h3>{{localize "NCI.Contract.GMHeading"}}</h3>
  <p class="nci-hint">{{localize "NCI.Contract.GMHint"}}</p>
  {{#with contract}}
  {{#if businesses.length}}
  <div class="nci-grid">
    <label>{{localize "NCI.Contract.Business"}}<select name="contractBusiness" data-contract-business>{{#each businesses}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>{{localize "NCI.Contract.Corp"}}<select name="contractCorp">{{#each corps}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
    <label>{{localize "NCI.Contract.Item"}}<select name="contractItem">{{#each items}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
    <label>{{localize "NCI.Contract.Count"}}<input type="number" name="contractCount" min="1" step="1" value="10"></label>
    <label>{{localize "NCI.Contract.Unit"}}<input type="number" name="contractUnit" min="1" step="1" placeholder="{{localize 'NCI.Contract.UnitMarket'}}"></label>
    <label>{{localize "NCI.Contract.Weeks"}}<input type="number" name="contractWeeks" min="1" max="12" step="1" value="{{weeks}}"></label>
  </div>
  {{#if full}}<p class="nci-warn">{{full}}</p>{{/if}}
  <div class="nci-actions"><button type="button" data-action="productionWriteContract"><i class="fas fa-file-signature"></i> {{localize "NCI.Contract.Write"}}</button></div>
  {{else}}
  <p class="nci-empty">{{none}}</p>
  {{/if}}
  {{/with}}

  {{#if contracts.length}}
  <table class="nci-market">
    <thead><tr><th>{{localize "NCI.Contract.Business"}}</th><th>{{localize "NCI.Contract.Corp"}}</th><th>{{localize "NCI.Contract.Item"}}</th><th>{{localize "NCI.Contract.Made"}}</th><th class="num">{{localize "NCI.Contract.Total"}}</th><th>{{localize "NCI.Contract.State"}}</th></tr></thead>
    <tbody>
      {{#each contracts}}
      <tr><td>{{business}}</td><td>{{corp}}</td><td>{{item}}</td><td>{{progress}}</td><td class="num">{{total}} eb</td><td class="nci-muted">{{status}}</td></tr>
      {{/each}}
    </tbody>
  </table>
  {{/if}}
</div>
{{/with}}
