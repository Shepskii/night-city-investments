{{#with factions}}
<div class="nci-block">
  <p class="nci-hint">{{localize "NCI.Faction.Hint"}}</p>
  <div class="nci-actions" data-faction-row>
    <label class="nci-inline">{{localize "NCI.Faction.Name"}} <input type="text" name="name" maxlength="60"></label>
    <label class="nci-inline">{{localize "NCI.Faction.KindLabel"}} <select name="kind">{{#each newKinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <button type="button" data-action="factionAdd"><i class="fas fa-plus"></i> {{localize "NCI.Faction.Add"}}</button>
    <button type="button" data-action="factionImport"><i class="fas fa-download"></i> {{localize "NCI.Faction.Import"}}</button>
  </div>

  {{#if rows.length}}
  <table class="nci-market">
    <thead><tr><th>{{localize "NCI.Faction.Name"}}</th><th>{{localize "NCI.Faction.KindLabel"}}</th><th>{{localize "NCI.Faction.Ticker"}}</th><th>{{localize "NCI.Faction.Districts"}}</th>{{#if messenger}}<th>{{localize "NCI.Faction.Contact"}}</th>{{/if}}<th></th></tr></thead>
    <tbody>
      {{#each rows}}
      <tr data-faction-row>
        <td><input type="text" name="name" value="{{name}}" maxlength="60"></td>
        <td><select name="kind">{{#each kinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></td>
        <td><input type="text" name="ticker" value="{{ticker}}" maxlength="5" class="nci-days"></td>
        <td><input type="text" name="districts" value="{{districtText}}"></td>
        {{#if ../messenger}}<td><input type="text" name="contact" value="{{contactName}}" list="nci-faction-contacts" maxlength="80"></td>{{/if}}
        <td class="nci-rowbtns">
          <button type="button" data-action="factionSave" data-id="{{id}}" title="{{localize 'NCI.Faction.Save'}}"><i class="fas fa-save"></i></button>
          <button type="button" data-action="factionRemove" data-id="{{id}}" title="{{localize 'NCI.Faction.Remove'}}"><i class="fas fa-trash"></i></button>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{#if messenger}}<datalist id="nci-faction-contacts">{{#each contactNames}}<option value="{{this}}"></option>{{/each}}</datalist>{{/if}}
  {{else}}<p class="nci-empty">{{localize "NCI.Faction.None"}}</p>{{/if}}
  <p class="nci-hint">{{localize "NCI.Faction.DistrictHint" ids=districtIds}}</p>
  {{#if messenger}}<p class="nci-hint">{{localize "NCI.Faction.ContactHint"}}</p>{{/if}}
</div>
{{#if districts.length}}
<div class="nci-block">
  <h3>{{localize "NCI.DistrictDefs.Title"}}</h3>
  <p class="nci-hint">{{localize "NCI.DistrictDefs.Hint"}}</p>
  <table class="nci-market">
    <thead><tr><th>{{localize "NCI.DistrictDefs.Name"}}</th><th>{{localize "NCI.DistrictDefs.Traffic"}}</th><th>{{localize "NCI.DistrictDefs.Rent"}}</th><th>{{localize "NCI.DistrictDefs.Risk"}}</th><th></th></tr></thead>
    <tbody>
      {{#each districts}}
      <tr data-district-row>
        <td>{{name}}{{#unless onMap}} <span class="nci-muted">({{localize "NCI.DistrictDefs.OffMap"}})</span>{{/unless}}</td>
        <td><input type="number" name="traffic" min="0.2" max="2" step="0.05" value="{{traffic}}"></td>
        <td><input type="number" name="rent" min="0.2" max="2" step="0.05" value="{{rent}}"></td>
        <td><input type="number" name="risk" min="0.2" max="3" step="0.05" value="{{risk}}"></td>
        <td><button type="button" data-action="districtSave" data-id="{{id}}">{{localize "NCI.DistrictDefs.Save"}}</button></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{/if}}
{{/with}}
