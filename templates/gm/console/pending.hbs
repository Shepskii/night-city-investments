<div class="nci-block">
  <h3>{{localize "NCI.Pending.Title"}}</h3>
  <p class="nci-hint">{{localize "NCI.Pending.Intro"}}</p>
  {{#if pendingRows.length}}
  <table class="nci-market nci-pending">
    <thead><tr><th>{{localize "NCI.Pending.Where"}}</th><th>{{localize "NCI.Pending.Item"}}</th><th>{{localize "NCI.Pending.Needed"}}</th><th>{{localize "NCI.Pending.Action"}}</th></tr></thead>
    <tbody>
      {{#each pendingRows}}
      <tr class="nci-row" data-action="switchTab" data-tab="{{tab}}">
        <td><button type="button" data-action="switchTab" data-tab="{{tab}}">{{where}}</button></td>
        <td>{{item}}</td>
        <td class="nci-muted">{{needed}}</td>
        <td class="nci-rowactions">
          <div class="nci-actions">
            {{#each fields}}
            {{#if isSelect}}<select name="{{name}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            {{else if isCheck}}<label class="nci-check"><input type="checkbox" name="{{name}}" {{#if checked}}checked{{/if}}> {{label}}</label>
            {{else}}<label class="nci-inline">{{label}} <input type="{{type}}" name="{{name}}" value="{{value}}"{{#if min includeZero=true}} min="{{min}}"{{/if}}{{#if max}} max="{{max}}"{{/if}}{{#if step}} step="{{step}}"{{/if}}></label>{{/if}}
            {{/each}}
            {{#each buttons}}<button type="button" data-action="{{action}}" data-id="{{id}}"{{#if staff}} data-staff="{{staff}}"{{/if}}{{#if yes}} data-yes="{{yes}}"{{/if}}{{#if reward}} data-reward="{{reward}}"{{/if}}><i class="fas {{icon}}"></i> {{label}}</button>{{/each}}
          </div>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="nci-empty">{{localize "NCI.Pending.None"}}</p>
  {{/if}}
</div>
