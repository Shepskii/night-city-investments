<div class="nci-block">
  <h3>{{localize "NCI.Pending.Title"}}</h3>
  <p class="nci-hint">{{localize "NCI.Pending.Intro"}}</p>
  {{#if pendingRows.length}}
  <table class="nci-market nci-pending nci-pendingtable">
    <thead><tr><th>{{localize "NCI.Pending.Type"}}</th><th>{{localize "NCI.Pending.Item"}}</th><th>{{localize "NCI.Pending.Needed"}}</th><th>{{localize "NCI.Pending.Action"}}</th></tr></thead>
    <tbody>
      {{#each pendingRows}}
      <tr class="nci-row" data-action="switchTab" data-tab="{{tab}}">
        <td>{{type}}{{#if seenText}}<div class="nci-stamp">{{seenText}}</div>{{/if}}</td>
        <td>{{item}}</td>
        <td class="nci-muted">{{needed}}</td>
        <td class="nci-rowactions">
          {{> "modules/night-city-investments/templates/gm/console/pending-controls.hbs"}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="nci-empty">{{localize "NCI.Pending.None"}}</p>
  {{/if}}
</div>
