<div class="nci-block">
  <h3>{{localize "NCI.GMBusiness.Title"}}</h3>
  <p class="nci-hint">{{localize "NCI.GMBusiness.Intro"}}</p>
  {{#unless businesses.enabled}}<p class="nci-warn">{{localize "NCI.Business.Disabled"}}</p>{{/unless}}
  <p class="nci-hint">{{localize "NCI.Faction.StandingHint"}}</p>
</div>

<div class="nci-block nci-form">
  <h3>{{localize "NCI.GMBusiness.Npc.Title"}}</h3>
  <p class="nci-hint">{{localize "NCI.GMBusiness.Npc.Hint"}}</p>
  <div class="nci-grid">
    <label>{{localize "NCI.GMBusiness.Npc.Name"}}<input type="text" name="npcName" maxlength="60"></label>
    <label>{{localize "NCI.GMBusiness.Npc.Archetype"}}<select name="npcArchetype">{{#each businesses.npcForm.archetypes}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
    <label>{{localize "NCI.GMBusiness.Npc.Owner"}}<input type="search" name="npcOwnerSearch" autocomplete="off" placeholder="{{localize 'NCI.GMBusiness.Npc.OwnerSearch'}}"><input type="hidden" name="npcOwner">
      <span class="nci-invite-results">{{#each businesses.npcForm.owners}}<button type="button" style="display: none" data-npc-owner data-id="{{value}}" data-name="{{label}}">{{label}}</button>{{/each}}</span></label>
    <label>{{localize "NCI.GMBusiness.Npc.OwnerLevel"}}<select name="npcLevel">{{#each businesses.npcForm.levels}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>{{localize "NCI.GMBusiness.Npc.StageLabel"}}<select name="npcStage">{{#each businesses.npcForm.stages}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>{{localize "NCI.GMBusiness.Npc.ProfileLabel"}}<select name="npcProfile">{{#each businesses.npcForm.profiles}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>{{localize "NCI.GMBusiness.Npc.Cash"}}<input type="number" name="npcCash" min="100" step="100" value="5000"></label>
    <label>{{localize "NCI.GMBusiness.Npc.Ticker"}}<input type="text" name="npcTicker" maxlength="5"></label>
    <label>{{localize "NCI.GMBusiness.Npc.District"}}<select name="npcDistrict">{{#each businesses.npcForm.districts}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
    <label>{{localize "NCI.GMBusiness.Npc.Location"}}<input type="text" name="npcLocation" maxlength="80"></label>
  </div>
  <div class="nci-actions"><button type="button" data-action="businessNpcCreate"><i class="fas fa-building"></i> {{localize "NCI.GMBusiness.Npc.Create"}}</button></div>
</div>

<div class="nci-block nci-form nci-corp-new">
  <h3>{{localize "NCI.GMBusiness.Corp.Title"}}</h3>
  <p class="nci-hint">{{localize "NCI.GMBusiness.Corp.Hint"}}</p>
  {{#with businesses.corp}}
  {{#if companies.length}}
  <div class="nci-grid">
    <label>{{localize "NCI.GMBusiness.Corp.Company"}}<select name="corpCompany">{{#each companies}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
    <label>{{localize "NCI.GMBusiness.Corp.Kind"}}<select name="corpKind">{{#each kinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>{{localize "NCI.GMBusiness.Corp.Dv"}}<input type="number" name="corpDv" min="9" max="30" step="1" value="{{dv}}"></label>
    <label>{{localize "NCI.GMBusiness.Corp.Location"}}<input type="text" name="corpLocation" maxlength="80"></label>
  </div>
  <p class="nci-hint">{{localize "NCI.GMBusiness.Corp.KindHint"}}</p>
  {{#with form}}
      <table class="nci-market nci-corp-roles"><thead><tr><th>{{localize "NCI.GMBusiness.Corp.Post"}}</th><th>{{localize "NCI.GMBusiness.Corp.Count"}}</th><th>{{localize "NCI.GMBusiness.Corp.Wage"}}</th></tr></thead><tbody>
        {{#each roles}}<tr><td>{{label}}</td><td><input type="number" name="corpCount_{{post}}" min="0" max="20" step="1" value="{{count}}"></td><td><input type="number" name="corpWage_{{post}}" min="0" step="10" value="{{wage}}"></td></tr>{{/each}}
      </tbody></table>
  {{/with}}
  <div class="nci-actions"><button type="button" data-action="businessCorpCreate"><i class="fas fa-briefcase"></i> {{localize "NCI.GMBusiness.Corp.Create"}}</button></div>
  {{else}}<p class="nci-empty">{{localize "NCI.GMBusiness.Corp.NoCompanies"}}</p>{{/if}}

  {{#each employers}}
  <div class="nci-gig nci-bizentry nci-form">
    <div class="nci-gigtop"><strong>{{name}}</strong> <span class="nci-muted">({{ticker}}) &middot; {{kindName}} &middot; DV {{dv}}</span>{{#if open}}<span class="nci-up">{{localize "NCI.GMBusiness.Corp.Hiring"}}</span>{{else}}<span class="nci-down">{{localize "NCI.GMBusiness.Corp.NotHiring"}}</span>{{/if}}</div>
    {{#if gone}}<div class="nci-warn">{{localize "NCI.GMBusiness.Corp.Gone"}}</div>{{/if}}
    {{#if staff.length}}
    <table class="nci-market"><thead><tr><th>{{localize "NCI.GMBusiness.Corp.Who"}}</th><th>{{localize "NCI.GMBusiness.Corp.Post"}}</th><th>{{localize "NCI.GMBusiness.Corp.Wage"}}</th><th>{{localize "NCI.GMBusiness.Corp.Standing"}}</th><th></th></tr></thead><tbody>
      {{#each staff}}<tr><td>{{{who}}}</td><td>{{post}}</td><td>{{wage}}</td><td>{{standing}}</td>
        <td class="nci-rowbtns"><button type="button" data-action="businessCorpDismiss" data-id="{{../id}}" data-staff="{{id}}"><i class="fas fa-person-walking-arrow-right"></i> {{dismissLabel}}</button></td></tr>{{/each}}
    </tbody></table>
    {{else}}<p class="nci-muted">{{localize "NCI.GMBusiness.Corp.NoStaff"}}</p>{{/if}}
    {{#if offer.characters.length}}{{#if offer.posts.length}}
    <div class="nci-actions">
      <label class="nci-inline">{{localize "NCI.GMBusiness.Corp.OfferTo"}} <select name="corpOfferActor">{{#each offer.characters}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
      <label class="nci-inline">{{localize "NCI.GMBusiness.Corp.As"}} <select name="corpOfferPost">{{#each offer.posts}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
      <button type="button" data-action="businessCorpOffer" data-id="{{id}}"><i class="fas fa-handshake"></i> {{localize "NCI.GMBusiness.Corp.Offer"}}</button>
    </div>
    {{/if}}{{/if}}
    <details>
      <summary>{{localize "NCI.GMBusiness.Corp.Edit"}}</summary>
      <div class="nci-grid">
        <label>{{localize "NCI.GMBusiness.Corp.Kind"}}<select name="corpKind">{{#each kinds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label>{{localize "NCI.GMBusiness.Corp.Dv"}}<input type="number" name="corpDv" min="9" max="30" step="1" value="{{dv}}"></label>
        <label>{{localize "NCI.GMBusiness.Corp.Location"}}<input type="text" name="corpLocation" maxlength="80" value="{{location}}"></label>
        <label class="nci-inline"><input type="checkbox" name="corpOpen" {{#if open}}checked{{/if}}> {{localize "NCI.GMBusiness.Corp.Hiring"}}</label>
      </div>
      <table class="nci-market nci-corp-roles"><thead><tr><th>{{localize "NCI.GMBusiness.Corp.Post"}}</th><th>{{localize "NCI.GMBusiness.Corp.Count"}}</th><th>{{localize "NCI.GMBusiness.Corp.Wage"}}</th></tr></thead><tbody>
        {{#each roles}}<tr><td>{{label}}</td><td><input type="number" name="corpCount_{{post}}" min="0" max="20" step="1" value="{{count}}"></td><td><input type="number" name="corpWage_{{post}}" min="0" step="10" value="{{wage}}"></td></tr>{{/each}}
      </tbody></table>
      <div class="nci-actions">
        <button type="button" data-action="businessCorpSave" data-id="{{id}}"><i class="fas fa-floppy-disk"></i> {{localize "NCI.GMBusiness.Corp.Save"}}</button>
        <button type="button" data-action="businessCorpRemove" data-id="{{id}}"><i class="fas fa-trash"></i> {{localize "NCI.GMBusiness.Corp.Remove"}}</button>
      </div>
    </details>
  </div>
  {{/each}}
  {{/with}}
</div>

<div class="nci-block">
  <h3>{{localize "NCI.GMBusiness.Waiting"}}</h3>
  {{#each businesses.pending}}
  <div class="nci-gig nci-bizentry">
    <div class="nci-bizhead">
      <div class="nci-bizname">{{name}}</div>
      <div class="nci-muted">{{archetype}}{{#if location}} &middot; {{location}}{{/if}}</div>
      <div class="nci-actions"><button type="button" data-action="businessOpen" data-id="{{id}}"><i class="fas fa-store"></i> {{localize "NCI.GMBusiness.Open"}}</button></div>
    </div>
    {{#if owners.length}}
    <table class="nci-market nci-owners nci-peoplecols">
      <thead><tr><th>{{localize "NCI.GMBusiness.Owner"}}</th><th>{{localize "NCI.GMBusiness.Status"}}</th><th class="num">{{localize "NCI.GMBusiness.Units"}}</th><th class="num">{{localize "NCI.GMBusiness.Share"}}</th></tr></thead>
      <tbody>{{#each owners}}<tr><td>{{{who}}}{{#if note}} <span class="nci-muted">{{note}}</span>{{/if}}</td><td class="nci-muted">{{status}}</td><td class="num">{{units}}</td><td class="num">{{share}}</td></tr>{{/each}}</tbody>
    </table>
    {{/if}}
    {{#if stats.length}}<div class="nci-gmstats">{{#each stats}}<span><span class="nci-muted">{{label}}</span> <strong>{{value}}</strong></span>{{/each}}</div>{{/if}}
    {{#if money}}<div>{{money}}</div>{{/if}}
    <div class="nci-muted">{{setup}}</div>
    <div class="nci-actions">
      <button type="button" data-action="businessApprove" data-id="{{id}}"><i class="fas fa-check"></i> {{localize "NCI.GMBusiness.Approve"}}</button>
      <button type="button" data-action="businessReject" data-id="{{id}}"><i class="fas fa-xmark"></i> {{localize "NCI.GMBusiness.Reject"}}</button>
    </div>
  </div>
  {{else}}{{#unless businesses.rewards.length}}<p class="nci-empty">{{localize "NCI.GMBusiness.NoneWaiting"}}</p>{{/unless}}{{/each}}
  {{#if businesses.rewards.length}}
  <table class="nci-market nci-pending nci-rewards">
    <thead><tr><th>{{localize "NCI.Reward.Title"}}</th><th></th><th></th></tr></thead>
    <tbody>{{#each businesses.rewards}}<tr><td>{{item}}</td><td class="nci-muted">{{needed}}</td><td class="nci-rowactions"><div class="nci-actions">
      {{#each fields}}<label class="nci-inline">{{label}} <input type="number" name="{{name}}" value="{{value}}" class="nci-days"></label>{{/each}}
      {{#each buttons}}<button type="button" data-action="{{action}}" data-id="{{id}}" data-reward="{{reward}}"><i class="fas {{icon}}"></i> {{label}}</button>{{/each}}
    </div></td></tr>{{/each}}</tbody>
  </table>
  {{/if}}
</div>

<div class="nci-block">
  <h3>{{localize "NCI.GMBusiness.Running"}}</h3>
  {{#each businesses.active}}
  <div class="nci-gig nci-bizentry">
    <div class="nci-bizhead">
      <div class="nci-bizname">{{name}}</div>
      <div><strong>{{status}}</strong> <span class="nci-muted">&middot; {{archetype}}{{#if location}} &middot; {{location}}{{/if}}</span></div>
      <div class="nci-actions"><button type="button" data-action="businessOpen" data-id="{{id}}"><i class="fas fa-store"></i> {{localize "NCI.GMBusiness.Open"}}</button></div>
    </div>
    {{#if npc}}
    <div class="nci-muted">{{npc.label}}</div>
    <div class="nci-actions">
      <label class="nci-inline">{{localize "NCI.GMBusiness.Npc.ProfileLabel"}} <select name="npcRunProfile">{{#each npc.profiles}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label class="nci-inline">{{localize "NCI.GMBusiness.Npc.OwnerLevel"}} <select name="npcRunLevel">{{#each npc.levels}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label class="nci-inline"><input type="checkbox" name="npcRunAuto" {{#if npc.auto}}checked{{/if}}> {{localize "NCI.GMBusiness.Npc.Auto"}}</label>
      <button type="button" data-action="businessNpcSave" data-id="{{id}}"><i class="fas fa-floppy-disk"></i> {{localize "NCI.GMBusiness.Npc.Save"}}</button>
    </div>
    {{/if}}
    {{#if stats.length}}<div class="nci-gmstats">{{#each stats}}<span><span class="nci-muted">{{label}}</span> <strong>{{value}}</strong></span>{{/each}}</div>{{/if}}
    {{#if money}}<div>{{money}}</div>{{/if}}
    {{#if setup}}<div class="nci-muted">{{setup}}</div>{{/if}}
    {{#if listing}}<div class="nci-warn">{{listing.text}}</div>{{/if}}
    {{#if regCase}}<div class="nci-warn">{{regCase.text}}</div>{{/if}}
    {{#if administration}}<div class="nci-warn">{{administration}}</div>{{/if}}
    {{#if takeover}}<div class="nci-warn">{{takeover.text}}</div>{{/if}}
    {{#if charter}}<div class="nci-warn">{{charter.text}}</div>{{/if}}
    {{#if campaign}}<div class="nci-warn">{{campaign}}</div>{{/if}}
    {{#if backRoom}}<div class="{{#if roomPending}}nci-warn{{else}}nci-muted{{/if}}">{{backRoom}}</div>{{/if}}
    {{#if roomDeal}}<div class="nci-muted">{{roomDeal}}</div>{{/if}}
    {{#if bigEvent}}<div class="nci-warn">{{bigEvent}}</div>{{/if}}
    {{#if scene}}<div class="nci-warn">{{scene}}</div>{{/if}}
    {{#if owners.length}}
    <table class="nci-market nci-owners nci-peoplecols">
      <thead><tr><th>{{localize "NCI.GMBusiness.Owner"}}</th><th>{{localize "NCI.GMBusiness.Status"}}</th><th class="num">{{localize "NCI.GMBusiness.Units"}}</th><th class="num">{{localize "NCI.GMBusiness.Share"}}</th></tr></thead>
      <tbody>{{#each owners}}<tr><td>{{{who}}}{{#if note}} <span class="nci-muted">{{note}}</span>{{/if}}</td><td class="nci-muted">{{status}}</td><td class="num">{{units}}</td><td class="num">{{share}}</td></tr>{{/each}}</tbody>
    </table>
    {{/if}}
    {{#if staff.length}}
    <table class="nci-market nci-owners nci-peoplecols">
      <thead><tr><th>{{localize "NCI.GMBusiness.Staff"}}</th><th>{{localize "NCI.GMBusiness.StaffPost"}}</th><th class="num">{{localize "NCI.GMBusiness.StaffWage"}}</th><th class="num">{{localize "NCI.GMBusiness.StaffLoyalty"}}</th></tr></thead>
      <tbody>{{#each staff}}<tr><td>{{{who}}}{{#if trait}} <span class="nci-muted">{{trait}}</span>{{/if}}{{#if note}} <span class="nci-muted">{{#if trait}}&middot; {{/if}}{{note}}</span>{{/if}}</td><td class="nci-muted">{{post}}</td><td class="num">{{wage}}</td><td class="num">{{#if teamId}}<input type="number" name="teamLoyalty" value="{{care}}" step="1" class="nci-days"> <button type="button" data-action="businessTeamLoyalty" data-id="{{../id}}" data-staff="{{teamId}}" title="{{localize 'NCI.GMBusiness.TeamLoyaltyHint'}}"><i class="fas fa-save"></i></button>{{else}}{{loyalty}}{{/if}}</td></tr>{{/each}}</tbody>
    </table>
    {{/if}}
    {{#if applicants}}<div class="nci-muted">{{applicants}}</div>{{/if}}
    {{#if standing.length}}
    <table class="nci-market nci-owners">
      <thead><tr><th>{{localize "NCI.Faction.StandingTitle"}}</th><th>{{localize "NCI.GMBusiness.Status"}}</th><th class="num">{{localize "NCI.GMBusiness.StandingValue"}}</th></tr></thead>
      <tbody>{{#each standing}}<tr><td>{{name}}{{#if turf}} <span class="nci-muted">{{turf}}</span>{{/if}}</td><td class="nci-faction-{{band}}">{{label}}</td><td class="num">{{value}}</td></tr>{{/each}}</tbody>
    </table>
    {{/if}}
    {{#if factionTerms}}<div class="nci-muted">{{factionTerms}}</div>{{/if}}
    <div class="nci-gmbuttons">
      {{#if listing.awaiting}}
      <div class="nci-actions">
        <button type="button" data-action="businessListingApprove" data-id="{{id}}"><i class="fas fa-chart-line"></i> {{localize "NCI.GMBusiness.ListingApprove"}}</button>
        <button type="button" data-action="businessListingReject" data-id="{{id}}"><i class="fas fa-xmark"></i> {{localize "NCI.GMBusiness.ListingReject"}}</button>
      </div>
      {{/if}}
      {{#if listing.review}}
      <div class="nci-actions">
        <button type="button" data-action="businessDelist" data-id="{{id}}"><i class="fas fa-ban"></i> {{localize "NCI.GMBusiness.Delist"}}</button>
        <button type="button" data-action="businessGiveTime" data-id="{{id}}"><i class="fas fa-hourglass-half"></i> {{localize "NCI.GMBusiness.GiveTime"}}</button>
      </div>
      {{/if}}
      {{#if regCase}}
      <div class="nci-actions">
        {{#if regCase.lost}}
        <label class="nci-inline">{{localize "NCI.GMBusiness.CaseFine"}} <input type="number" name="caseFine" min="0" step="100" value="{{regCase.fine}}"></label>
        <button type="button" data-action="businessCaseFine" data-id="{{id}}"><i class="fas fa-gavel"></i> {{localize "NCI.GMBusiness.CaseApprove"}}</button>
        {{/if}}
        <button type="button" data-action="businessCaseDrop" data-id="{{id}}"><i class="fas fa-xmark"></i> {{localize "NCI.GMBusiness.CaseDrop"}}</button>
      </div>
      {{/if}}
      {{#if administration}}
      <div class="nci-actions">
        <button type="button" data-action="businessRestructure" data-id="{{id}}"><i class="fas fa-scale-balanced"></i> {{localize "NCI.GMBusiness.Restructure"}}</button>
        <button type="button" data-action="businessWindUp" data-id="{{id}}"><i class="fas fa-skull"></i> {{localize "NCI.GMBusiness.WindUp"}}</button>
      </div>
      {{/if}}
      {{#if takeover.awaiting}}
      <div class="nci-actions">
        <button type="button" data-action="businessTakeoverApprove" data-id="{{id}}"><i class="fas fa-check"></i> {{localize "NCI.GMBusiness.TakeoverApprove"}}</button>
        <button type="button" data-action="businessTakeoverReject" data-id="{{id}}"><i class="fas fa-xmark"></i> {{localize "NCI.GMBusiness.TakeoverReject"}}</button>
      </div>
      {{/if}}
      {{#if charter.awaiting}}
      <div class="nci-actions">
        <button type="button" data-action="businessCharterApprove" data-id="{{id}}"><i class="fas fa-file-signature"></i> {{localize "NCI.GMBusiness.CharterApprove"}}</button>
        <button type="button" data-action="businessCharterReject" data-id="{{id}}"><i class="fas fa-xmark"></i> {{localize "NCI.GMBusiness.CharterReject"}}</button>
      </div>
      {{/if}}
      {{#if roomPending}}
      <div class="nci-actions">
        <button type="button" data-action="businessRoomApprove" data-id="{{id}}"><i class="fas fa-check"></i> {{localize "NCI.GMBusiness.RoomApprove"}}</button>
        <button type="button" data-action="businessRoomReject" data-id="{{id}}"><i class="fas fa-xmark"></i> {{localize "NCI.GMBusiness.RoomReject"}}</button>
      </div>
      {{/if}}
      {{#if bigEvent}}
      <div class="nci-actions">
        <button type="button" data-action="businessSceneRun" data-id="{{id}}"><i class="fas fa-masks-theater"></i> {{localize "NCI.GMBusiness.SceneRun"}}</button>
      </div>
      {{/if}}
      {{#if scene}}
      <div class="nci-actions">
        <button type="button" data-action="businessSceneWon" data-id="{{id}}"><i class="fas fa-check"></i> {{localize "NCI.GMBusiness.SceneWon"}}</button>
        <button type="button" data-action="businessSceneLost" data-id="{{id}}"><i class="fas fa-xmark"></i> {{localize "NCI.GMBusiness.SceneLost"}}</button>
        <button type="button" data-action="businessSceneRoll" data-id="{{id}}"><i class="fas fa-dice-d10"></i> {{localize "NCI.GMBusiness.SceneRoll"}}</button>
      </div>
      {{/if}}
      {{#if campaign}}
      <div class="nci-actions">
        <button type="button" data-action="businessCampaignApprove" data-id="{{id}}"><i class="fas fa-check"></i> {{localize "NCI.GMBusiness.CampaignApprove"}}</button>
        <button type="button" data-action="businessCampaignReject" data-id="{{id}}"><i class="fas fa-xmark"></i> {{localize "NCI.GMBusiness.CampaignReject"}}</button>
      </div>
      {{/if}}
      {{#each offers}}
      <div class="nci-warn">{{{text}}}</div>
      <div class="nci-actions">
        <button type="button" data-action="businessStaffAnswer" data-id="{{../id}}" data-staff="{{id}}" data-yes="true"><i class="fas fa-handshake"></i> {{localize "NCI.GMBusiness.StaffAccept"}}</button>
        <button type="button" data-action="businessStaffAnswer" data-id="{{../id}}" data-staff="{{id}}" data-yes="false"><i class="fas fa-xmark"></i> {{localize "NCI.GMBusiness.StaffDecline"}}</button>
      </div>
      {{/each}}
      {{#if factionOptions.length}}
      <div class="nci-actions">
        <select name="standingFaction">{{#each factionOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
        <input type="number" name="standingValue" min="-100" max="100" step="1" value="0" class="nci-days">
        <button type="button" data-action="businessSetStanding" data-id="{{id}}"><i class="fas fa-handshake"></i> {{localize "NCI.Faction.SetStanding"}}</button>
      </div>
      {{/if}}
      {{#if isOpen}}{{#if leavers.length}}
      <div class="nci-actions">
        <select name="leaver">{{#each leavers}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
        <button type="button" data-action="businessPartnerLeaves" data-id="{{id}}" title="{{localize 'NCI.GMBusiness.LeavesHint'}}"><i class="fas fa-person-walking-arrow-right"></i> {{localize "NCI.GMBusiness.Leaves"}}</button>
      </div>
      {{/if}}{{/if}}
      {{#if canOpenCase}}
      <div class="nci-actions">
        <button type="button" data-action="businessCaseOpen" data-id="{{id}}"><i class="fas fa-scale-balanced"></i> {{localize "NCI.GMBusiness.CaseOpen"}}</button>
      </div>
      {{/if}}
      {{#if isForming}}
      <div class="nci-actions">
        <button type="button" data-action="businessReject" data-id="{{id}}"><i class="fas fa-xmark"></i> {{localize "NCI.GMBusiness.Cancel"}}</button>
      </div>
      {{/if}}
    </div>
  </div>
  {{else}}<p class="nci-empty">{{localize "NCI.GMBusiness.NoneRunning"}}</p>{{/each}}
</div>

{{#if businesses.closed.length}}
<div class="nci-block">
  <h3>{{localize "NCI.GMBusiness.ClosedTitle"}}</h3>
  <table class="nci-market"><tbody>
    {{#each businesses.closed}}
    <tr><td><strong>{{name}}</strong> <span class="nci-muted">{{archetype}}</span></td><td class="nci-muted">{{closed}}</td>
      <td class="nci-rowbtns"><button type="button" data-action="businessRemove" data-id="{{id}}" title="{{localize 'NCI.GMBusiness.Remove'}}"><i class="fas fa-trash"></i></button></td></tr>
    {{/each}}
  </tbody></table>
</div>
{{/if}}
