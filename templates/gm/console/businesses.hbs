<div class="nci-block">
  <h3>{{localize "NCI.GMBusiness.Title"}}</h3>
  <p class="nci-hint">{{localize "NCI.GMBusiness.Intro"}}</p>
  {{#unless businesses.enabled}}<p class="nci-warn">{{localize "NCI.Business.Disabled"}}</p>{{/unless}}
</div>

<div class="nci-block">
  <h3>{{localize "NCI.GMBusiness.Waiting"}}</h3>
  {{#each businesses.pending}}
  <div class="nci-gig">
    <div class="nci-gigtop"><strong>{{name}}</strong><span class="nci-muted">{{archetype}}{{#if location}} &middot; {{location}}{{/if}}</span></div>
    {{#if owners.length}}
    <table class="nci-market nci-owners">
      <thead><tr><th>{{localize "NCI.GMBusiness.Owner"}}</th><th>{{localize "NCI.GMBusiness.Status"}}</th><th class="num">{{localize "NCI.GMBusiness.Units"}}</th><th class="num">{{localize "NCI.GMBusiness.Share"}}</th></tr></thead>
      <tbody>{{#each owners}}<tr><td>{{{who}}}{{#if note}} <span class="nci-muted">{{note}}</span>{{/if}}</td><td class="nci-muted">{{status}}</td><td class="num">{{units}}</td><td class="num">{{share}}</td></tr>{{/each}}</tbody>
    </table>
    {{/if}}
    {{#if stats.length}}<div class="nci-gmstats">{{#each stats}}<span><span class="nci-muted">{{label}}</span> <strong>{{value}}</strong></span>{{/each}}</div>{{/if}}
    {{#if money}}<div>{{money}}</div>{{/if}}
    <div class="nci-muted">{{setup}}</div>
    <div class="nci-actions">
      <button type="button" data-action="businessApprove" data-id="{{id}}"><i class="fas fa-check"></i> {{localize "NCI.GMBusiness.Approve"}}</button>
      <button type="button" data-action="businessReject" data-id="{{id}}"><i class="fas fa-xmark"></i> {{localize "NCI.GMBusiness.Reject"}}</button>
      <button type="button" data-action="businessOpen" data-id="{{id}}"><i class="fas fa-store"></i> {{localize "NCI.GMBusiness.Open"}}</button>
    </div>
  </div>
  {{else}}<p class="nci-empty">{{localize "NCI.GMBusiness.NoneWaiting"}}</p>{{/each}}
</div>

<div class="nci-block">
  <h3>{{localize "NCI.GMBusiness.Running"}}</h3>
  {{#each businesses.active}}
  <div class="nci-gig">
    <div class="nci-gigtop"><strong>{{name}}</strong><span>{{status}}</span><span class="nci-muted">{{archetype}}{{#if location}} &middot; {{location}}{{/if}}</span></div>
    {{#if stats.length}}<div class="nci-gmstats">{{#each stats}}<span><span class="nci-muted">{{label}}</span> <strong>{{value}}</strong></span>{{/each}}</div>{{/if}}
    {{#if money}}<div>{{money}}</div>{{/if}}
    {{#if owners.length}}
    <table class="nci-market nci-owners">
      <thead><tr><th>{{localize "NCI.GMBusiness.Owner"}}</th><th>{{localize "NCI.GMBusiness.Status"}}</th><th class="num">{{localize "NCI.GMBusiness.Units"}}</th><th class="num">{{localize "NCI.GMBusiness.Share"}}</th></tr></thead>
      <tbody>{{#each owners}}<tr><td>{{{who}}}{{#if note}} <span class="nci-muted">{{note}}</span>{{/if}}</td><td class="nci-muted">{{status}}</td><td class="num">{{units}}</td><td class="num">{{share}}</td></tr>{{/each}}</tbody>
    </table>
    {{/if}}
    {{#if setup}}<div class="nci-muted">{{setup}}</div>{{/if}}
    {{#if listing}}
    <div class="nci-warn">{{listing.text}}</div>
    {{#if listing.awaiting}}
    <div class="nci-actions">
      <button type="button" data-action="businessListingApprove" data-id="{{id}}"><i class="fas fa-chart-line"></i> {{localize "NCI.GMBusiness.ListingApprove"}}</button>
      <button type="button" data-action="businessListingReject" data-id="{{id}}"><i class="fas fa-xmark"></i> {{localize "NCI.GMBusiness.ListingReject"}}</button>
    </div>
    {{/if}}
    {{/if}}
    {{#if charter}}
    <div class="nci-warn">{{charter.text}}</div>
    {{#if charter.awaiting}}
    <div class="nci-actions">
      <button type="button" data-action="businessCharterApprove" data-id="{{id}}"><i class="fas fa-file-signature"></i> {{localize "NCI.GMBusiness.CharterApprove"}}</button>
      <button type="button" data-action="businessCharterReject" data-id="{{id}}"><i class="fas fa-xmark"></i> {{localize "NCI.GMBusiness.CharterReject"}}</button>
    </div>
    {{/if}}
    {{/if}}
    {{#if staff}}<div class="nci-muted">{{localize "NCI.GMBusiness.Staff"}}: {{{staff}}}</div>{{/if}}
    {{#if applicants}}<div class="nci-muted">{{applicants}}</div>{{/if}}
    {{#each offers}}
    <div class="nci-warn">{{{text}}}</div>
    <div class="nci-actions">
      <button type="button" data-action="businessStaffAnswer" data-id="{{../id}}" data-staff="{{id}}" data-yes="true"><i class="fas fa-handshake"></i> {{localize "NCI.GMBusiness.StaffAccept"}}</button>
      <button type="button" data-action="businessStaffAnswer" data-id="{{../id}}" data-staff="{{id}}" data-yes="false"><i class="fas fa-xmark"></i> {{localize "NCI.GMBusiness.StaffDecline"}}</button>
    </div>
    {{/each}}
    <div class="nci-actions">
      <button type="button" data-action="businessOpen" data-id="{{id}}"><i class="fas fa-store"></i> {{localize "NCI.GMBusiness.Open"}}</button>
      {{#if isOpen}}{{#if leavers.length}}
      <select name="leaver">{{#each leavers}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
      <button type="button" data-action="businessPartnerLeaves" data-id="{{id}}" title="{{localize 'NCI.GMBusiness.LeavesHint'}}"><i class="fas fa-person-walking-arrow-right"></i> {{localize "NCI.GMBusiness.Leaves"}}</button>
      {{/if}}{{/if}}
      {{#if isForming}}<button type="button" data-action="businessReject" data-id="{{id}}"><i class="fas fa-xmark"></i> {{localize "NCI.GMBusiness.Cancel"}}</button>{{/if}}
    </div>
  </div>
  {{else}}<p class="nci-empty">{{localize "NCI.GMBusiness.NoneRunning"}}</p>{{/each}}
</div>

{{#if businesses.closed.length}}
<div class="nci-block">
  <h3>{{localize "NCI.GMBusiness.ClosedTitle"}}</h3>
  <table class="nci-market"><tbody>
    {{#each businesses.closed}}
    <tr><td><strong>{{name}}</strong> <span class="nci-muted">{{archetype}}</span></td><td class="nci-muted">{{closed}}</td>
      <td class="nci-rowbtns"><button type="button" data-action="businessRemove" data-id="{{id}}" title="{{localize 'NCI.GMBusiness.Remove'}}"><i class="fas fa-trash"></i></button></td></tr>
    {{/each}}
  </tbody></table>
</div>
{{/if}}
